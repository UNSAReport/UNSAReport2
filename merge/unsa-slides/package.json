{
  "name": "unsa-slides",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @unsa-slides/web dev",
    "dev:web": "bun --filter @unsa-slides/web dev",
    "dev:cli": "bun --filter @unsa-slides/cli dev",
    "build": "bun --filter \"*\" build",
    "build:web": "bun --filter @unsa-slides/web build",
    "test": "vitest run",
    "db:push": "bun --filter @unsa-slides/db db:push",
    "db:generate": "bun --filter @unsa-slides/db db:generate",
    "db:studio": "bun --filter @unsa-slides/db db:studio",
    "lint:format": "biome format --write",
    "lint:check": "biome check --write",
    "typecheck": "bun --filter \"*\" typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/bun": "latest",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^3.0.7"
  },
  "license": "AGPL-3.0"
}
