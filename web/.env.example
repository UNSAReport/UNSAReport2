# Website frontend defaults. Materialized as web/.env.<ENV> via `just decrypt <env>`.
# Local overrides: web/.env.<ENV>.override

# Identity Provider / Auth — dev uses Traefik single entrypoint http://localhost:9876 (mirrors k8s ingress)
IDP_ISSUER=http://localhost:9876/api/auth
IDP_JWKS_URL=http://localhost:9876/.well-known/jwks.json
CLIENT_REDIRECT_URL=http://localhost:9876

# Service Networking & Gateway Ingress
BASE_URL=http://localhost:9876
REGISTRY_URL=http://localhost:9876/api/registry
PORT=3100
