# TUI client overrides (used by unsarep) — dev single Traefik entrypoint http://localhost:9876
# Local overrides: tui/.env.<ENV>.override

# Service Endpoints — points to local gateway running on port 9876
UNSAREP_REGISTRY_URL=http://localhost:9876/api/registry
UNSAREP_IDP_ISSUER=http://localhost:9876/api/auth
UNSAREP_WEBSITE_URL=http://localhost:9876

# Authentication — Personal Access Token (PAT) or JWT token (leave empty to log in interactively)
UNSAREP_TOKEN=

# Optional Client Overrides
UNSAREP_SLIDES_URL=http://localhost:9876/api/slides
# UNSAREP_LOCALE=es
# UNSAREP_TOKEN_PATH=~/.config/unsareport/token
# UNSAREP_CREDENTIALS_PATH=~/.config/unsareport/credentials.json
