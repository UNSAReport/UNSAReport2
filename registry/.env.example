# Registry service defaults. Generated as registry/.env.<ENV> via `just decrypt <env>`.
# Local overrides: registry/.env.<ENV>.override

DATABASE_URL=postgresql://registry:registrypassword@localhost:5433/registry_db
IDP_ISSUER=http://localhost:9876/api/auth
IDP_JWKS_URL=http://localhost:9876/.well-known/jwks.json
PORT=3001
ALLOWED_ORIGINS=http://localhost:9876
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=unsareport-registry
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
MAX_PENDING_PACKAGES=5

# Run DB migrations on boot
AUTO_MIGRATE=true
