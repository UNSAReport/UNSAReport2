# Registry service defaults. Materialized as registry/.env.<ENV> via `just decrypt <env>`.
# Local overrides: registry/.env.<ENV>.override

# Database — localhost when running registry outside Docker; port 5433
DATABASE_URL=postgresql://registry:registrypassword@localhost:5433/registry_db

# Identity Provider / Auth — dev uses Traefik single entrypoint http://localhost:9876 (mirrors k8s ingress)
IDP_ISSUER=http://localhost:9876/api/auth
IDP_JWKS_URL=http://localhost:9876/.well-known/jwks.json

# Service Networking & Gateway Ingress
PORT=3001
ALLOWED_ORIGINS=http://localhost:9876

# S3 / MinIO Object Storage (packages storage) — dev uses local MinIO on port 9000
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=unsareport-registry
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Package Registry Limits
MAX_PENDING_PACKAGES=5

# Run DB migrations on boot
AUTO_MIGRATE=true
