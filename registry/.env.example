DATABASE_URL=postgresql://registry:registrypassword@localhost:5433/registry_db

IDP_ISSUER=http://localhost:9876/api/auth
IDP_JWKS_URL=http://localhost:9876/api/auth/.well-known/jwks.json

PORT=3001
ALLOWED_ORIGINS=http://localhost:9876

S3_ENDPOINT=http://localhost:8333
S3_BUCKET=unsareport-registry
S3_ACCESS_KEY=seaweedadmin
S3_SECRET_KEY=seaweedadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

MAX_PENDING_PACKAGES=5
MAX_ARCHIVE_BYTES=52428800

AUTO_MIGRATE=true
