# Slides service defaults. Generated as slides/.env.<ENV> via `just decrypt <env>`.
# Local overrides: slides/.env.<ENV>.override

DATABASE_URL=postgresql://slides:slidespassword@localhost:5434/slides_db
SLIDES_DATABASE_URL=postgresql://slides:slidespassword@localhost:5434/slides_db
IDP_ISSUER=http://localhost:9876/api/auth
IDP_JWKS_URL=http://localhost:9876/.well-known/jwks.json
BASE_URL=http://localhost:9876
PORT=3002
SLIDES_PORT=3002
ALLOWED_ORIGINS=http://localhost:9876

# Run DB migrations on boot
AUTO_MIGRATE=true
