# Slides service defaults. Materialized as slides/.env.<ENV> via `just decrypt <env>`.
# Local overrides: slides/.env.<ENV>.override

# Database — localhost when running slides outside Docker; port 5434
DATABASE_URL=postgresql://slides:slidespassword@localhost:5434/slides_db

# Identity Provider / Auth — dev uses Traefik single entrypoint http://localhost:9876 (mirrors k8s ingress)
IDP_ISSUER=http://localhost:9876/api/auth
IDP_JWKS_URL=http://localhost:9876/.well-known/jwks.json

# Service Networking & Gateway Ingress
BASE_URL=http://localhost:9876
PORT=3002
ALLOWED_ORIGINS=http://localhost:9876

# Run DB migrations on boot
AUTO_MIGRATE=true
