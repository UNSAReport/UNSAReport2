# Website env — local defaults point to local auth/registry (see auth/.env.example + registry/docker-compose.yml)
IDP_ISSUER=http://localhost:3002
IDP_JWKS_URL=http://localhost:3002/.well-known/jwks.json
REGISTRY_URL=http://localhost:3001
CLIENT_REDIRECT_URL=http://localhost:3000
BASE_URL=http://localhost:3000
PORT=3000
IDP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
