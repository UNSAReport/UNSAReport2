# UNSAReport monorepo — global dev env (single Traefik entrypoint http://localhost:9876)
# Service-only settings live in auth/.env.<ENV>, registry/.env.<ENV>, slides/.env.<ENV>, web/.env.<ENV>, and tui/.env.<ENV>.
# Materialized as .env.<ENV> via `just decrypt <env>`:
#   1. Copies .env.example
#   2. Appends sops-decrypted secrets/global.<ENV>.enc.env (if SOPS keys present)
#   3. Appends .env.<ENV>.override (if present; gitignored for contributor-specific overrides)

# Gateway / Ingress (mirrors k8s ingress routing via Traefik on port 9876)
BASE_URL=http://localhost:9876
CLIENT_REDIRECT_URL=http://localhost:9876
ALLOWED_ORIGINS=http://localhost:9876

# Identity Provider / Auth (public endpoints)
IDP_ISSUER=http://localhost:9876/api/auth
IDP_JWKS_URL=http://localhost:9876/.well-known/jwks.json

# Service Gateway Routes
REGISTRY_URL=http://localhost:9876/api/registry

# TUI Client Overrides (used by unsarep)
UNSAREP_REGISTRY_URL=http://localhost:9876/api/registry
UNSAREP_IDP_ISSUER=http://localhost:9876/api/auth
UNSAREP_SLIDES_URL=http://localhost:9876/api/slides
UNSAREP_WEBSITE_URL=http://localhost:9876
UNSAREP_TOKEN=

# -----------------------------------------------------------------------------
# Service Reference Architecture (configured in subapp .env.<ENV> files):
#
# Ports & Ingress:
#   auth:     PORT=3000 (IDP_PORT) -> http://localhost:9876/api/auth
#   registry: PORT=3001            -> http://localhost:9876/api/registry
#   slides:   PORT=3002            -> http://localhost:9876/api/slides
#   website:  PORT=3100            -> http://localhost:9876/
#
# Databases (PostgreSQL containers via compose.dev.yml):
#   auth:     DATABASE_URL=postgresql://idp:idppassword@localhost:5432/idp_db
#   registry: DATABASE_URL=postgresql://registry:registrypassword@localhost:5433/registry_db
#   slides:   DATABASE_URL=postgresql://slides:slidespassword@localhost:5434/slides_db
#
# Object Storage (SeaweedFS container via compose.dev.yml):
#   registry: S3_ENDPOINT=http://localhost:8333, S3_BUCKET=unsareport-registry
# -----------------------------------------------------------------------------
