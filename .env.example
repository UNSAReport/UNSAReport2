# UNSAReport monorepo — global dev env (single Traefik entrypoint http://localhost:9876)
# Service-only settings live in auth/.env.dev and registry/.env.dev.
# Generated as .env.dev via `moon run decrypt` (copies this file; overlays sops secrets when available).

# TUI client overrides (used by unsarep)
UNSAREP_REGISTRY_URL=http://localhost:9876/api/registry
UNSAREP_IDP_ISSUER=http://localhost:9876/api/auth
UNSAREP_WEBSITE_URL=http://localhost:9876
UNSAREP_TOKEN=

# Gateway / ingress (mirrors k8s ingress paths)
IDP_ISSUER=http://localhost:9876/api/auth
IDP_JWKS_URL=http://localhost:9876/.well-known/jwks.json
REGISTRY_URL=http://localhost:9876/api/registry
BASE_URL=http://localhost:9876
CLIENT_REDIRECT_URL=http://localhost:9876
IDP_ALLOWED_ORIGINS=http://localhost:9876
ALLOWED_ORIGINS=http://localhost:9876

# Databases — localhost when services run natively via moon; postgres-auth :5432, postgres-registry :5433
DATABASE_URL=postgresql://registry:registrypassword@localhost:5433/registry_db
AUTH_DATABASE_URL=postgresql://idp:idppassword@localhost:5432/idp_db

# S3 / MinIO (host ports 9000/9001)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=unsareport-registry
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Service ports (native moon dev)
PORT=3001
IDP_PORT=3000
WEBSITE_PORT=3100
